#include	"resource.h"
#include	<windows.h>

LIGHTICON	ICON	"../resource/@APP_NAME@Light.ico"
DARKICON	ICON	"../resource/@APP_NAME@Dark.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION		@APP_VERSION_MAJOR@,@APP_VERSION_MINOR@,@APP_VERSION_PATCH@,0
PRODUCTVERSION	@PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS			VOS_NT_WINDOWS32
FILETYPE		VFT_APP
{
	BLOCK "StringFileInfo"
	{
		BLOCK "000004b0"
		{
			VALUE	"Comments",			""
			VALUE	"CompanyName",		"Narezzurri"
			VALUE	"FileDescription",	"OpenVPN Config @APP_FULLNAME@"
			VALUE	"FileVersion",		"@APP_VERSION_MAJOR@.@APP_VERSION_MINOR@.@APP_VERSION_PATCH@"
			VALUE	"InternalName",		"@APP_NAME@"
			VALUE	"LegalCopyright",	"Copyright (C) 2026 Narezzurri. All rights reserved."
			VALUE	"LegalTrademarks",	""
			VALUE	"OriginalFilename",	"@OUTPUT_NAME@"
			VALUE	"ProductName",		"OpenVPN Config Manager"
			VALUE	"ProductVersion",	"@PROJECT_VERSION@"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE	"Translation",0x0000,0x04b0					// Language Neutral
	}
}
